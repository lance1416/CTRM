{
  "$schema": "https://ctrm.example/schema/preset-v1.json",
  "format": "ctrm-preset",
  "formatVersion": 1,
  "name": "Photo numbering (IMG_0001)",
  "description": "Changes each name to IMG_ and a number with 4 digits. The extension does not change.",
  "createdWith": "CTRM 0.1.0",
  "options": {
    "portableNames": true,
    "folderExtensions": false,
    "autoResolveDuplicates": false
  },
  "rules": [
    {
      "type": "numbering",
      "enabled": true,
      "target": "stem",
      "start": 1,
      "step": 1,
      "padding": 4,
      "position": "replace",
      "separator": "_",
      "index": 0,
      "fromEnd": false,
      "scope": "checked"
    },
    {
      "type": "insert",
      "enabled": true,
      "target": "stem",
      "text": "IMG_",
      "position": "prefix",
      "index": 0,
      "fromEnd": false
    }
  ]
}
