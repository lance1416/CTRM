#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# pre-commit hook: fast checks on the staged changes only.
#   1. No staged files under docs/ (docs/ stays local to the owner).
#   2. No trailing whitespace and no conflict markers (git diff --check).
#   3. New source files have the SPDX-License-Identifier line.
#   4. scripts/lint.sh --staged: editorconfig-checker and clang-format.
# To skip the hook in an emergency: git commit --no-verify

set -u

spdx='SPDX-License-Identifier: GPL-3.0-or-later'
status=0

err() {
    printf 'pre-commit: %s\n' "$1" >&2
    status=1
}

if git rev-parse --verify -q HEAD >/dev/null; then
    against=HEAD
else
    against=$(git hash-object -t tree /dev/null)
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR "$against")
added=$(git diff --cached --name-only --diff-filter=A "$against")

# 1. docs/
docs=$(git diff --cached --name-only "$against" -- docs/)
if [ -n "$docs" ]; then
    err 'these files are under docs/, which must stay untracked:'
    printf '%s\n' "$docs" | sed 's/^/    /' >&2
    printf '  Fix: git restore --staged docs/\n\n' >&2
fi

# 2. Trailing whitespace and conflict markers.
if ! check_out=$(git diff --cached --check "$against" 2>&1); then
    err 'trailing whitespace or conflict markers in staged changes:'
    printf '%s\n' "$check_out" | sed 's/^/    /' >&2
    printf '  Fix: remove them, then run git add again.\n\n' >&2
fi

[ -n "$staged" ] || exit "$status"

is_cxx() {
    case $1 in
        *.c | *.cc | *.cpp | *.cxx | *.h | *.hh | *.hpp | *.hxx | *.ipp | *.inl | *.mm) return 0 ;;
    esac
    return 1
}

needs_spdx() {
    is_cxx "$1" && return 0
    case $1 in
        CMakeLists.txt | */CMakeLists.txt | *.cmake | *.sh | *.ps1 | *.py) return 0 ;;
    esac
    return 1
}

# 3. SPDX line in the first 5 lines of new source files.
missing_spdx=$(printf '%s\n' "$added" | while IFS= read -r f; do
    if [ -z "$f" ] || ! needs_spdx "$f"; then continue; fi
    git show ":$f" | head -n 5 | grep -q "$spdx" || printf '%s\n' "$f"
done)
if [ -n "$missing_spdx" ]; then
    err "these new files do not have '$spdx' in the first 5 lines:"
    printf '%s\n' "$missing_spdx" | sed 's/^/    /' >&2
    printf '  Fix: add "// %s" (C/C++) or "# %s" (CMake, scripts) at the top.\n\n' \
        "$spdx" "$spdx" >&2
fi

# 4. EditorConfig and clang-format on the staged content (same checks as CI).
if ! sh scripts/lint.sh --staged; then
    status=1
fi

exit "$status"
